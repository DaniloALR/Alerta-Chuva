{
  "versao": "2.0.0",
  "descricao": "Regras do motor de parsing PII do AlertaChuva. Para criar uma regra nova basta adicionar um objeto em 'regras' (e, se precisar de validação matemática, um validador em pii_engine.VALIDADORES).",
  "categorias": {
    "IDENTIFICACAO": {"peso": 10, "lgpd": "dado pessoal (art. 5º, I)"},
    "SAUDE":         {"peso": 10, "lgpd": "dado pessoal SENSÍVEL (art. 5º, II e art. 11)"},
    "CREDENCIAL":    {"peso": 9,  "lgpd": "segredo de autenticação (art. 46: segurança)"},
    "FINANCEIRO":    {"peso": 8,  "lgpd": "dado pessoal com risco de fraude"},
    "LOCALIZACAO":   {"peso": 7,  "lgpd": "dado pessoal: expõe onde a pessoa mora"},
    "CONTATO":       {"peso": 5,  "lgpd": "dado pessoal: vetor de golpe/phishing"},
    "NASCIMENTO":    {"peso": 4,  "lgpd": "dado pessoal: facilita roubo de identidade"}
  },
  "regras": [
    {"id": "BR_CPF", "categoria": "IDENTIFICACAO",
     "padrao": "(?<![\\d.])\\d{3}[.\\s]?\\d{3}[.\\s]?\\d{3}[-.\\s/]?\\d{2}(?![\\d])",
     "validador": "cpf", "contexto": ["cpf", "c.p.f", "cadastro de pessoa"], "mascara": "cpf",
     "descricao": "CPF com ou sem pontuação, validado pelos dígitos verificadores"},
    {"id": "BR_RG", "categoria": "IDENTIFICACAO",
     "padrao": "(?<![\\d.])\\d{1,2}\\.?\\d{3}\\.?\\d{3}-?[\\dXx](?![\\d])",
     "requer_contexto": true, "contexto": ["rg", "identidade", "registro geral"], "mascara": "id",
     "descricao": "RG (só com palavra de contexto, para evitar falso positivo)"},
    {"id": "BR_CNS", "categoria": "SAUDE",
     "padrao": "(?<!\\d)[1-27-9]\\d{2}[\\s.]?\\d{4}[\\s.]?\\d{4}[\\s.]?\\d{4}(?!\\d)",
     "validador": "cns", "contexto": ["cns", "cartão sus", "cartao sus", "sus"], "mascara": "id",
     "descricao": "Cartão Nacional de Saúde (SUS), validado pelo módulo 11"},
    {"id": "SAUDE_CONDICAO", "categoria": "SAUDE",
     "padrao": "(?i)\\b(diab[eé]tic[oa]s?|diabetes|hipertens\\w*|cadeirante|acamad[oa]s?|gestante|gr[aá]vida|oxig[eê]nio domiciliar|hemodi[aá]lise|di[aá]lise|marca-?passo|defici[eê]ncia (?:visual|auditiva|f[ií]sica|intelectual)|autis\\w*|epilep\\w*|hiv|c[aâ]ncer|quimioterapia|insulino-?dependente|mobilidade reduzida|esquizofreni\\w*|depress[aã]o|alzheimer|parkinson)\\b",
     "mascara": "saude", "descricao": "Condição de saúde ou vulnerabilidade (dado sensível LGPD)"},
    {"id": "SAUDE_CID", "categoria": "SAUDE",
     "padrao": "(?i)\\bCID(?:-?10)?[\\s:]*[A-TV-Z]\\d{2}(?:\\.\\d{1,2})?\\b",
     "mascara": "saude", "descricao": "Código de doença CID-10"},
    {"id": "CRED_SENHA", "categoria": "CREDENCIAL",
     "padrao": "(?i)[\"']?\\b(senha|password|passwd|pwd|secret|segredo)\\b[\"']?\\s*[:=]\\s*[\"']?(?!\\[)[^\\s\"',;&}]{3,}",
     "mascara": "credencial", "descricao": "Par chave=valor de senha (log, URL, JSON)"},
    {"id": "CRED_URL_SENHA", "categoria": "CREDENCIAL",
     "padrao": "(?i)\\b[a-z][a-z0-9+.-]*://(?!\\*\\*\\*:)[^\\s:/@]+:[^\\s:/@]+@[^\\s/]+",
     "mascara": "credencial_url", "descricao": "String de conexão com usuário:senha (banco, broker MQTT)"},
    {"id": "CRED_JWT", "categoria": "CREDENCIAL",
     "padrao": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b",
     "mascara": "segredo", "descricao": "Token JWT"},
    {"id": "CRED_API_KEY", "categoria": "CREDENCIAL",
     "padrao": "\\b(?:sk-(?:ant-|proj-)?[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{30,}|AIza[0-9A-Za-z_-]{35})\\b",
     "mascara": "segredo", "descricao": "Chaves de API (Anthropic/OpenAI, AWS, GitHub, Google)"},
    {"id": "CRED_BEARER", "categoria": "CREDENCIAL",
     "padrao": "(?i)\\bbearer\\s+[A-Za-z0-9._~+/-]{16,}=*",
     "mascara": "segredo", "descricao": "Cabeçalho Authorization: Bearer"},
    {"id": "CARTAO", "categoria": "FINANCEIRO",
     "padrao": "(?<!\\d)(?:\\d[ -]?){12,18}\\d(?!\\d)",
     "validador": "luhn", "contexto": ["cartão", "cartao", "card", "crédito", "credito"], "mascara": "cartao",
     "descricao": "Cartão de pagamento (Luhn)"},
    {"id": "TELEFONE_BR", "categoria": "CONTATO",
     "padrao": "(?<![\\d])(?:\\+?55[\\s-]?)?\\(?[1-9]{2}\\)?[\\s-]?9?\\s?\\d{4}[\\s.-]?\\d{4}(?![\\d])",
     "validador": "telefone", "contexto": ["tel", "telefone", "celular", "whatsapp", "zap", "fone", "contato"], "mascara": "telefone",
     "descricao": "Telefone fixo ou celular brasileiro (DDD validado)"},
    {"id": "EMAIL", "categoria": "CONTATO",
     "padrao": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
     "mascara": "email", "descricao": "Endereço de e-mail"},
    {"id": "ENDERECO", "categoria": "LOCALIZACAO",
     "padrao": "(?i)\\b(?:rua|r\\.|avenida|av\\.|travessa|tv\\.|estrada|estr\\.|alameda|al\\.|pra[cç]a|viela|beco|rodovia)\\s+[A-Za-zÀ-ÿ0-9' .-]{2,60}?,?\\s*(?:n[ºo°.]*\\s*)?\\d{1,5}\\b",
     "mascara": "endereco", "descricao": "Logradouro com número (localiza a casa do morador)"},
    {"id": "CEP", "categoria": "LOCALIZACAO",
     "padrao": "(?<![\\d])\\d{5}-\\d{3}(?![\\d])|(?<![\\d])\\d{8}(?![\\d])",
     "requer_contexto_se": "\\d{8}", "contexto": ["cep"], "mascara": "cep",
     "descricao": "CEP (formato 00000-000, ou 8 dígitos com a palavra CEP por perto)"},
    {"id": "GEOLOC_PRECISA", "categoria": "LOCALIZACAO",
     "padrao": "-?\\d{1,2}\\.\\d{4,}\\s*[,;/ ]\\s*-?\\d{1,3}\\.\\d{4,}",
     "mascara": "geo", "descricao": "Coordenada GPS com precisão de casa (4+ casas decimais)"},
    {"id": "DATA_NASC", "categoria": "NASCIMENTO",
     "padrao": "\\b(?:0?[1-9]|[12]\\d|3[01])[/.-](?:0?[1-9]|1[0-2])[/.-](?:19|20)\\d{2}\\b",
     "requer_contexto": true, "contexto": ["nasc", "nascimento", "nascido", "nascida", "idade", "dn"], "mascara": "data",
     "descricao": "Data de nascimento (com contexto)"}
  ],
  "chaves_sensiveis": {
    "cpf": "BR_CPF", "documento": "BR_CPF", "rg": "BR_RG", "cns": "BR_CNS", "cartao_sus": "BR_CNS",
    "senha": "CRED_SENHA", "password": "CRED_SENHA", "token": "CRED_JWT", "api_key": "CRED_API_KEY", "authorization": "CRED_BEARER", "secret": "CRED_SENHA",
    "telefone": "TELEFONE_BR", "celular": "TELEFONE_BR", "whatsapp": "TELEFONE_BR", "email": "EMAIL",
    "endereco": "ENDERECO", "logradouro": "ENDERECO", "cep": "CEP", "lat": "GEOLOC_PRECISA", "latitude": "GEOLOC_PRECISA", "lon": "GEOLOC_PRECISA", "longitude": "GEOLOC_PRECISA",
    "condicao_saude": "SAUDE_CONDICAO", "saude": "SAUDE_CONDICAO", "cid": "SAUDE_CID", "data_nascimento": "DATA_NASC", "nascimento": "DATA_NASC", "cartao": "CARTAO"
  }
}
